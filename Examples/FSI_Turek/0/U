FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{

    cylinder
    {
        type            noSlip;
    }    

    flap
    {
        type            movingWallVelocity;
        value           uniform (0 0 0);
    }

    top
    {
        type            noSlip;
    }

    bottom
    {
        type            noSlip;
    }

    inlet
    {
        type            codedFixedValue;
        value           uniform (0 0 0);
        name            parabolicInlet;

        code
        #{
            const scalar Umean = 1.0;
            const scalar H = 0.41;
            const scalar t = this->db().time().value();

            scalar ramp = 1.0;
            if (t <= 2.0)
            {
                ramp = 0.5*(1.0 - cos(0.5*constant::mathematical::pi*t));
            }

            forAll(*this, faceI)
            {
                const scalar y = patch().Cf()[faceI].y();

                const scalar Ux =
                    ramp * 6.0*Umean*y*(H-y)/(H*H);

                operator[](faceI) = vector(Ux, 0.0, 0.0);
            }
        #};
    }

    outlet
    {
        type            zeroGradient;
    }

    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
}

